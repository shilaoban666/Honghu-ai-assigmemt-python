# Honghu AI — environment variables
# Copy this to .env and fill in your values.

# ===================== AI Provider Keys =====================
DEEPSEEK_CLOUD_API_KEY=sk-xxxx
OPENAI_API_KEY=sk-xxxx
ALIYUN_API_KEY=sk-xxxx
GEMINI_API_KEY=

# ===================== Database =====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=12345

# ===================== Redis =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=12345

# ===================== Milvus =====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# ===================== JWT =====================
APP_SECURITY_JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
APP_SECURITY_DEV_HEADER_FALLBACK=true

# ===================== Ollama (optional) =====================
OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# ===================== AWS (optional — for S3/SQS/SES) =====================
AWS_REGION=us-east-1
AWS_S3_ENABLED=false
AWS_SQS_ENABLED=false
AWS_SES_ENABLED=false
